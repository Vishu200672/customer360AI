# Customer360 AI Backend Configuration
PROJECT_NAME="Customer360 AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customer360_db"

# CORS Configuration (comma-separated or JSON list of origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ML & Decision Intelligence Integration (Vishvam)
# Options: "local" (uses local rule-based heuristic with clear demo tag) or "remote" (calls Vishvam's deployed Hugging Face service)
ML_MODE="local"
ML_SERVICE_URL="https://vishu2006-customer.hf.space"
ML_REQUEST_TIMEOUT_SECONDS=15.0
ML_API_KEY=""

# Logging
LOG_LEVEL="INFO"
