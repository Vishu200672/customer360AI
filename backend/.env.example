PORT=8000
NODE_ENV=development
PROJECT_NAME="Customer360 AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customer360_db"

# ML Microservice Integration (Hugging Face Space)
ML_MODE="remote"
ML_SERVICE_URL="https://vishu2006-customer.hf.space"
ML_REQUEST_TIMEOUT_MS=15000

# Authentication & Session Security
JWT_SECRET="c360-super-secret-auth-key-2026"

# Email Security Alert Notifications (Optional SMTP: Gmail, SendGrid, Mailtrap, etc.)
# If left blank, automatic test sandbox (Ethereal preview & in-app security log) is activated
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM='"Customer360 AI Security" <security@customer360.ai>'

